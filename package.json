{
  "name": "mini-minecraft",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.miniminecraft.app",
    "directories": { "output": "dist" },
    "files": ["**/*", "!node_modules/**/*"],
    "mac": { "target": ["dmg","zip"] },
    "win": { "target": ["nsis","zip"] }
  },
  "devDependencies": {
    "electron": "^22.0.0",
    "electron-builder": "^24.0.0"
  }
}
